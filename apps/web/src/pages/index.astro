---
import AppLayout from '@/layouts/AppLayout.astro';
import { DashboardIsland } from '@/islands/dashboard-island';
import { fetchDashboardData } from '@/islands/dashboard-island/data';
import { serverApi } from '@/lib/api';
import { createTranslator, normalizeLocale } from '@/lib/i18n';

const cookie = Astro.request.headers.get('cookie') ?? undefined;
const api = serverApi(cookie);
const locale = normalizeLocale(Astro.currentLocale);
const t = createTranslator(locale);

const [initial, studentsList] = await Promise.all([
  fetchDashboardData(api.get),
  api.get<{ id: string; name: string }[]>('/students', { query: { includeArchived: true } }),
]);
const studentNames = Object.fromEntries(studentsList.map((s) => [s.id, s.name]));
---

<AppLayout
  title={t('Dashboard')}
  description={t(
    'Your tutor finance dashboard: upcoming lessons, daily stats, recent income, and student activity at a glance.',
  )}
>
  <DashboardIsland client:load initial={initial} studentNames={studentNames} locale={locale} />
</AppLayout>
