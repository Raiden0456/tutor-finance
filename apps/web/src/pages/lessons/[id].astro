---
import AppLayout from '@/layouts/AppLayout.astro';
import { LessonDetailIsland } from '@/islands/lesson-detail-island';
import { ApiError, serverApi } from '@/lib/api';
import { createTranslator, localizePath, normalizeLocale } from '@/lib/i18n';
import type { Lesson, Student } from '@/lib/types';

const { id } = Astro.params;
const cookie = Astro.request.headers.get('cookie') ?? undefined;
const locale = normalizeLocale(Astro.currentLocale);
const t = createTranslator(locale);
const api = serverApi(cookie);

let lesson: Lesson;
let student: Student;
try {
  lesson = await api.get<Lesson>(`/lessons/${id}`);
  student = await api.get<Student>(`/students/${lesson.studentId}`);
} catch (err) {
  if (err instanceof ApiError && [400, 403, 404].includes(err.status)) {
    return Astro.rewrite(localizePath('/404', locale));
  }
  throw err;
}
---

<AppLayout
  title={t('Lesson with {name}', { name: student.name })}
  description={t(
    'Lesson details for {name}: schedule, payment status, notes, homework, and meeting link in Uchetka.',
    { name: student.name },
  )}
>
  <LessonDetailIsland client:load lesson={lesson} student={student} locale={locale} />
</AppLayout>
