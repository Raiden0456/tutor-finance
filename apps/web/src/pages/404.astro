---
import AuthLayout from '@/layouts/AuthLayout.astro';
import { createTranslator, localizePath, normalizeLocale } from '@/lib/i18n';

const locale = normalizeLocale(Astro.currentLocale);
const t = createTranslator(locale);
---

<AuthLayout title={t('Page not found')}>
  <div class="flex flex-col items-center gap-4 text-center">
    <p class="text-6xl font-bold text-muted-foreground">404</p>
    <h1 class="text-xl font-bold">{t('Page not found')}</h1>
    <p class="text-sm text-muted-foreground">
      {t('This page does not exist or you do not have access to it.')}
    </p>
    <a
      href={localizePath('/', locale)}
      class="inline-flex h-10 items-center justify-center rounded-full bg-primary px-5 text-sm font-medium text-primary-foreground shadow-sm transition-all duration-200 ease-in-out hover:opacity-90 active:scale-95"
    >
      {t('Back to dashboard')}
    </a>
  </div>
</AuthLayout>
